BLOCKED_REDIRECT_HOSTS=
ALLOWED_REDIRECT_HOSTS=
METRICS_TOKEN=

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

ANALYTICS_RETENTION_DAYS=90
ANALYTICS_QUEUE_MAX_SIZE=5000
ANALYTICS_FLUSH_INTERVAL_MS=5000
